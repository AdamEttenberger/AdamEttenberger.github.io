{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ESNext", "DOM"],
    "module": "esnext",
    "types": ["node", "@webgpu/types"],
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "isolatedModules": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
  },
  "include": [
    "src/**/*",
    "eslint.config.ts",
  ],
  "exclude": ["node_modules", "dist"],
}
